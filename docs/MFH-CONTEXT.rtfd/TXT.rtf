## \uc0\u45936 \u51060 \u53552  \u50672 \u44228  \u47784 \u45944  (Supabase \u49828 \u53412 \u47560  \u52488 \u50504 )\
\
```sql\
-- \uc0\u44536 \u54644  \u51452 \u51228 \'b7\u47785 \u54364  (\u50724 \u54532 \u45789 /\u54856  \u48176 \u45320 )\
create table year_themes (\
  id uuid primary key default gen_random_uuid(),\
  user_id uuid not null default auth.uid() references auth.users,\
  year int not null, theme text, goals jsonb, created_at timestamptz default now()\
);\
\
-- \uc0\u54532 \u47196 \u51229 \u53944 \
create table projects (\
  id uuid primary key default gen_random_uuid(),\
  user_id uuid not null default auth.uid() references auth.users,\
  title text not null, description text,\
  status text default 'active',          -- active/onhold/done\
  priority text default 'med',            -- high/med/low\
  importance int default 0,\
  start_date date, due_date date,\
  created_at timestamptz default now(), updated_at timestamptz default now()\
);\
\
-- Task (\uc0\u54532 \u47196 \u51229 \u53944 \u50640  \u50672 \u44208 , \u45800 \u46021 \u46020  \u54728 \u50857 )\
create table tasks (\
  id uuid primary key default gen_random_uuid(),\
  user_id uuid not null default auth.uid() references auth.users,\
  project_id uuid references projects on delete set null,\
  title text not null, done boolean default false,\
  priority text default 'med', importance int default 0,\
  due_date date, completed_at timestamptz,\
  created_at timestamptz default now()\
);\
\
-- \uc0\u51068 \u51648  (\u54532 \u47196 \u51229 \u53944 /Task \u50672 \u44228  \u49440 \u53469 , \u45800 \u46021  \u54876 \u46041  \u54728 \u50857 )\
create table journal_entries (\
  id uuid primary key default gen_random_uuid(),\
  user_id uuid not null default auth.uid() references auth.users,\
  entry_date date not null,\
  category text,                          -- \uc0\u44368 \u54924 \u49324 \u50669 /\u49440 \u44368 \u49324 \u44032 \u51221 /\u54984 \u47144 \'b7\u54665 \u51221 /\u44596 \u44553 \u44396 \u54840 /\u48169 \u44284 \u54980 \u54617 \u44368 \
  headline text, today text, thanks text, meditation text, prayer text,\
  prayer_candidate boolean default false,\
  photo_path text,                        -- storage: journal-photos\
  project_id uuid references projects on delete set null,\
  task_id uuid references tasks on delete set null,\
  created_at timestamptz default now()\
);\
\
-- \uc0\u51064 \u49324 \u51060 \u53944  (\u48516 \u50556 \u48324 /\u51333 \u54633  + \u48324 \u51216  \u54588 \u46300 \u48177 )\
create table insights (\
  id uuid primary key default gen_random_uuid(),\
  user_id uuid not null default auth.uid() references auth.users,\
  domain text not null,                   -- journal/project/task/overall\
  period_start date, period_end date,\
  content text, model text,\
  rating int, feedback_note text,         -- \uc0\u9733  \u54588 \u46300 \u48177  \u8594  \u49440 \u54840  \u54532 \u47196 \u54028 \u51068 \
  created_at timestamptz default now()\
);\
\
-- (v3) \uc0\u50900 \u44036  \u44592 \u46020 \u54200 \u51648 \
create table letters (\
  id uuid primary key default gen_random_uuid(),\
  user_id uuid not null default auth.uid() references auth.users,\
  year_month text not null, number text, title text,\
  status text default 'draft',\
  section_nation text, section_ministry text, section_family text,\
  source_entry_ids jsonb, created_at timestamptz default now()\
);\
```\
\
- \uc0\u47784 \u46304  \u53580 \u51060 \u48660  **RLS on** (`auth.uid() = user_id`). Storage \u48260 \u53431  `journal-photos`(RLS).\
- \uc0\u50672 \u44228  \u54645 \u49900 : \u51068 \u51648 \'b7Task \u51032  `project_id`, \u51068 \u51648 \u51032  `task_id` \u44032  nullable \u8594  **\u50672 \u44228 \u46020  \u45800 \u46021 \u46020 ** \u44032 \u45733 .\
